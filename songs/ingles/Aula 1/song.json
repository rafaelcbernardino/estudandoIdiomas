    { "start":  0,   "end": 41,   "text": "",                                                          "section": "Intro" },
    { "start": 41,   "end": 45,   "text": "Hello",                                                     "section": "Verso 1" },
    { "start": 45,   "end": 49,   "text": "It's me" },
    { "start": 49,   "end": 56,   "text": "I was wondering if after all these years" },
    { "start": 56,   "end": 60,   "text": "You'd like to meet" },
    { "start": 60,   "end": 63,   "text": "To go over everything" },
    { "start": 63,   "end": 69,   "text": "They say that time's supposed to heal ya" },
    { "start": 69,   "end": 75,   "text": "But I ain't done much healing",                             "blanks": [{ "num": 1, "word": "I" }] },
    { "start": 75,   "end": 83,   "text": "Hello, can you hear me?",                                   "blanks": [{ "num": 2, "word": "Hello" }], "section": "Pré-refrão" },
    { "start": 83,   "end": 90,   "text": "I'm in California dreaming about who we used to be" },
    { "start": 90,   "end": 94,   "text": "When we were younger and free" },
    { "start": 94,   "end": 101,  "text": "I've forgotten how it felt before the world fell at our feet" },
    { "start": 101,  "end": 107,  "text": "There's such a difference between us",                     "section": "Bridge" },
    { "start": 107,  "end": 111,  "text": "And a million miles" },
    { "start": 111,  "end": 118,  "text": "Hello from the other side",                                 "blanks": [{ "num": 3, "word": "Hello" }], "section": "Refrão 1" },
    { "start": 118,  "end": 125,  "text": "I must've called a thousand times" },
    { "start": 125,  "end": 129,  "text": "To tell you I'm sorry",                                     "blanks": [{ "num": 4, "word": "you" }] },
    { "start": 129,  "end": 132,  "text": "For everything that I've done" },
    { "start": 132,  "end": 136,  "text": "But when I call you never" },
    { "start": 136,  "end": 140,  "text": "Seem to be home" },
    { "start": 140,  "end": 147,  "text": "Hello from the outside",                                    "blanks": [{ "num": 5, "word": "Hello" }] },
    { "start": 147,  "end": 154,  "text": "At least I can say that I've tried" },
    { "start": 154,  "end": 158,  "text": "To tell you I'm sorry",                                     "blanks": [{ "num": 6, "word": "sorry" }] },
    { "start": 158,  "end": 162,  "text": "For breaking your heart" },
    { "start": 162,  "end": 165,  "text": "But it don't matter, it clearly" },
    { "start": 165,  "end": 170,  "text": "Doesn't tear you apart anymore",                            "blanks": [{ "num": 7, "word": "you" }] },
    { "start": 170,  "end": 178,  "text": "",                                                          "section": "Transição" },
    { "start": 178,  "end": 185,  "text": "Hello, how are you?",                                       "blanks": [{ "num": 8, "word": "How are you?" }], "section": "Verso 2" },
    { "start": 185,  "end": 192,  "text": "It's so typical of me to talk about myself" },
    { "start": 192,  "end": 195,  "text": "I'm sorry," },
    { "start": 195,  "end": 198,  "text": "I hope that you're well" },
    { "start": 198,  "end": 205,  "text": "Did you ever make it out of that town" },
    { "start": 205,  "end": 210,  "text": "Where nothing ever happened?" },
    { "start": 210,  "end": 216,  "text": "It's no secret that the both of us" },
    { "start": 216,  "end": 221,  "text": "Are running out of time" },
    { "start": 221,  "end": 228,  "text": "So hello from the other side",                              "blanks": [{ "num": 9, "word": "Hello" }], "section": "Refrão 2" },
